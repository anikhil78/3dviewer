<?xml version="1.0"?>
<!--
  arctos_sim.xacro
  Robot description for Gazebo Harmonic simulation.

  Includes the mechanical model from arctos_description and adds:
    1. ros2_control block using gz_ros2_control/GazeboSimSystem (replaces the
       CAN-based ArctosInterface used on real hardware)
    2. Gazebo gz_ros2_control system plugin
    3. Fixed depth camera stand attached to world with an rgbd_camera sensor
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arctos_sim">

  <!-- ================================================================== -->
  <!-- Include mechanical description (links, joints, meshes, inertias)    -->
  <!-- Do NOT include arctos.ros2_control.xacro — that uses ArctosInterface -->
  <!-- ================================================================== -->
  <xacro:include filename="$(find arctos_description)/urdf/arctos.xacro"/>

  <!-- ================================================================== -->
  <!-- ros2_control block — Gazebo hardware plugin                         -->
  <!-- Joint definitions mirror arctos.ros2_control.xacro exactly so the  -->
  <!-- same controllers.yaml works unchanged.                              -->
  <!-- ================================================================== -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="X_joint">
      <command_interface name="position">
        <param name="min">-3.14159265</param>
        <param name="max">3.14159265</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-3.15</param>
        <param name="max">3.15</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Y_joint">
      <command_interface name="position">
        <param name="min">-0.96</param>
        <param name="max">2.18</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-3.15</param>
        <param name="max">3.15</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Z_joint">
      <command_interface name="position">
        <param name="min">-1.5708</param>
        <param name="max">0.9599</param>  <!-- 55/180*pi -->
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-3.15</param>
        <param name="max">3.15</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="A_joint">
      <command_interface name="position">
        <param name="min">-1.5708</param>
        <param name="max">1.5708</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-3.2</param>
        <param name="max">3.2</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="B_joint">
      <command_interface name="position">
        <param name="min">-1.55</param>
        <param name="max">1.55</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-3.2</param>
        <param name="max">3.2</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="C_joint">
      <command_interface name="position">
        <param name="min">-3.14159265</param>
        <param name="max">3.14159265</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-3.2</param>
        <param name="max">3.2</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Left_jaw_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.015</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

  <!-- ================================================================== -->
  <!-- Gazebo gz_ros2_control system plugin                                -->
  <!-- This hooks ros2_control into the Gazebo simulation loop.            -->
  <!-- ================================================================== -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find arctos_gazebo)/config/sim_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- ================================================================== -->
  <!-- Eye-in-hand RGBD camera mounted on the robot end effector           -->
  <!--                                                                     -->
  <!-- Parent link: Gripper_1 (child of C_joint, parent of jaw joints).   -->
  <!--                                                                     -->
  <!-- camera_link      — physical camera body; Gazebo camera looks along  -->
  <!--                    its +X axis, so rpy below aims the sensor.       -->
  <!-- camera_optical_frame — ROS camera convention (Z fwd, X right, Y↓)  -->
  <!--                                                                     -->
  <!-- ADJUST origin xyz/rpy on camera_joint to match your actual camera   -->
  <!-- mount position.  Current default:                                   -->
  <!--   xyz="0.06 0 0.04"  — 6 cm forward, 4 cm above gripper origin    -->
  <!--   rpy="0 0.5236 0"   — pitched 30° downward to see grasp point     -->
  <!-- ================================================================== -->

  <!-- Camera body (small box, visible in RViz/Gazebo) -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.02"/>
      </geometry>
      <material name="camera_dark">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.000001" iyy="0.000001" izz="0.000001"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="Gripper_1"/>
    <child link="camera_link"/>
    <!-- 6 cm forward along gripper X, 4 cm above, pitched 30° down toward grasp -->
    <origin xyz="0.06 0.0 0.04" rpy="0 0.5236 0"/>
  </joint>

  <!-- ROS optical frame: Z forward, X right, Y down -->
  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- RGBD sensor (Gazebo Harmonic).                                      -->
  <!-- Near clip 0.05 m suits close-range grasping; far 1.5 m covers the  -->
  <!-- full reachable workspace of the Arctos arm.                         -->
  <gazebo reference="camera_optical_frame">
    <sensor name="depth_camera" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.047</horizontal_fov>  <!-- 60° FOV -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>1.5</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
    </sensor>
  </gazebo>

</robot>
