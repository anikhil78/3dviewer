<?xml version="1.0"?>
<!--
  arctos_sim.xacro
  Robot description for Gazebo Harmonic simulation.

  Includes the mechanical model from arctos_description and adds:
    1. ros2_control block using gz_ros2_control/GazeboSimSystem (replaces the
       CAN-based ArctosInterface used on real hardware)
    2. Gazebo gz_ros2_control system plugin
    3. Fixed depth camera stand attached to world with an rgbd_camera sensor
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arctos_sim">

  <!-- ================================================================== -->
  <!-- Include mechanical description (links, joints, meshes, inertias)    -->
  <!-- Do NOT include arctos.ros2_control.xacro — that uses ArctosInterface -->
  <!-- ================================================================== -->
  <xacro:include filename="$(find arctos_description)/urdf/arctos.xacro"/>

  <!-- ================================================================== -->
  <!-- ros2_control block — Gazebo hardware plugin                         -->
  <!-- Joint definitions mirror arctos.ros2_control.xacro exactly so the  -->
  <!-- same controllers.yaml works unchanged.                              -->
  <!-- ================================================================== -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="X_joint">
      <command_interface name="position">
        <param name="min">-3.14159265</param>
        <param name="max">3.14159265</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-3.15</param>
        <param name="max">3.15</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Y_joint">
      <command_interface name="position">
        <param name="min">-0.96</param>
        <param name="max">2.18</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-3.15</param>
        <param name="max">3.15</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Z_joint">
      <command_interface name="position">
        <param name="min">-1.5708</param>
        <param name="max">0.9599</param>  <!-- 55/180*pi -->
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-3.15</param>
        <param name="max">3.15</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="A_joint">
      <command_interface name="position">
        <param name="min">-1.5708</param>
        <param name="max">1.5708</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-3.2</param>
        <param name="max">3.2</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="B_joint">
      <command_interface name="position">
        <param name="min">-1.55</param>
        <param name="max">1.55</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-3.2</param>
        <param name="max">3.2</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="C_joint">
      <command_interface name="position">
        <param name="min">-3.14159265</param>
        <param name="max">3.14159265</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-3.2</param>
        <param name="max">3.2</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Left_jaw_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.015</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

  <!-- ================================================================== -->
  <!-- Gazebo gz_ros2_control system plugin                                -->
  <!-- This hooks ros2_control into the Gazebo simulation loop.            -->
  <!-- ================================================================== -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find arctos_gazebo)/config/sim_controllers.yaml</parameters>
      <ros>
        <remapping>~/robot_description:=/robot_description</remapping>
      </ros>
    </plugin>
  </gazebo>

  <!-- ================================================================== -->
  <!-- Depth camera on a fixed stand                                       -->
  <!--                                                                     -->
  <!-- Placement: 0.8 m in front of the robot base, 0.9 m high, angled   -->
  <!-- ~37° downward so the lens covers the full workspace.               -->
  <!--                                                                     -->
  <!-- Coordinate note: Gazebo rgbd_camera looks along the link's +X axis. -->
  <!-- The camera_joint rpy rotates the stand top so +X faces the robot.  -->
  <!-- Fine-tune the pitch (second rpy value) to adjust the field of view. -->
  <!-- ================================================================== -->

  <!-- Vertical stand pole -->
  <link name="camera_stand">
    <visual>
      <origin xyz="0 0 0.45" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.9"/>
      </geometry>
      <material name="Black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.45" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.9"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.068" iyy="0.068" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Stand is fixed to world at (0.8, 0, 0) -->
  <joint name="camera_stand_joint" type="fixed">
    <parent link="world"/>
    <child link="camera_stand"/>
    <origin xyz="0.8 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- Camera housing at the top of the stand -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.04 0.04"/>
      </geometry>
      <material name="Black"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!--
    Rotate the camera to face the robot.
    rpy="0 0.6435 3.14159":
      - 3.14159 (yaw 180°) : turns the camera to face -X (toward the robot)
      - 0.6435  (pitch +37°): tilts the lens downward toward the workspace
    Adjust these values if you want a different viewing angle.
  -->
  <joint name="camera_joint" type="fixed">
    <parent link="camera_stand"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0.9" rpy="0 0.6435 3.14159"/>
  </joint>

  <!--
    Optical frame: ROS camera convention has Z forward, X right, Y down.
    This extra fixed joint converts from the standard ROS body frame
    (X forward, Y left, Z up) used by camera_link.
  -->
  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ================================================================== -->
  <!-- rgbd_camera sensor attached to camera_optical_frame                 -->
  <!-- Publishes to Gazebo topics:                                         -->
  <!--   /camera/image         (RGB)                                       -->
  <!--   /camera/depth_image   (depth, float32)                            -->
  <!--   /camera/camera_info                                               -->
  <!--   /camera/points        (PointCloud2)                               -->
  <!-- The ros_gz_bridge in sim.launch.py forwards these into ROS2.        -->
  <!-- ================================================================== -->
  <gazebo reference="camera_optical_frame">
    <sensor name="depth_camera" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.047</horizontal_fov>  <!-- 60 degrees -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>5.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
    </sensor>
  </gazebo>

</robot>
