<?xml version="1.0"?>
<!--
  arctos_sim.xacro
  Robot description for Gazebo Harmonic simulation.

  Includes the mechanical model from arctos_description and adds:
    1. ros2_control block using gz_ros2_control/GazeboSimSystem (replaces the
       CAN-based ArctosInterface used on real hardware)
    2. Gazebo gz_ros2_control system plugin
    3. Intel RealSense D435 RGBD camera fixed to base_link (world-fixed
       viewpoint covering the full arm workspace)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arctos_sim">

  <!-- ================================================================== -->
  <!-- Include mechanical description (links, joints, meshes, inertias)    -->
  <!-- Do NOT include arctos.ros2_control.xacro — that uses ArctosInterface -->
  <!-- ================================================================== -->
  <xacro:include filename="$(find arctos_description)/urdf/arctos.xacro"/>

  <!-- ================================================================== -->
  <!-- ros2_control block — Gazebo hardware plugin                         -->
  <!-- Mirrors arctos.ros2_control.xacro (real hardware) interface types  -->
  <!-- so the same controllers.yaml structure works in both contexts.      -->
  <!-- ================================================================== -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!--
      Arm joints use POSITION command interface — same as real hardware.

      GazeboSimSystem applies position commands via JointPositionReset in
      DART, which kinematically sets the joint position each physics step.
      This matches what the real ArctosInterface does (motor servo to a
      target position).  It is unconditionally stable at startup: the JTC
      sends q_des=0 from the very first PreUpdate call, so DART never has a
      chance to let gravity move the joints.  No PID tuning, no gravity
      compensation, no timing gymnastics required.

      arctos.xacro already contains "world_joint" (fixed, world→base_link)
      so DART treats the base as rigidly anchored — not free-floating.
      robot_state_publisher publishes the world→base_link TF automatically
      from this fixed joint; no separate static_transform_publisher needed.
    -->

    <joint name="X_joint">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max"> 3.14159</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Y_joint">
      <command_interface name="position">
        <param name="min">-0.96</param>
        <param name="max"> 2.18</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Z_joint">
      <command_interface name="position">
        <param name="min">-1.5708</param>
        <param name="max"> 0.9599</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="A_joint">
      <command_interface name="position">
        <param name="min">-1.5708</param>
        <param name="max"> 1.5708</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="B_joint">
      <command_interface name="position">
        <param name="min">-1.55</param>
        <param name="max"> 1.55</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="C_joint">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max"> 3.14159</param>
      </command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Left_jaw_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.015</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <!--
      Right_jaw_joint: mimic of Left_jaw_joint via gz_ros2_control software mimic.

      DART physics (used by Gazebo Harmonic) does not support SDF-level mimic
      constraints, so the physics engine logs an error and leaves Right_jaw_joint
      uncontrolled.  By declaring it here with <param name="mimic">, GazeboSimSystem
      commands Right_jaw_joint directly each physics step to track Left_jaw_joint,
      bypassing the physics-engine constraint entirely.

      multiplier: adjust sign/scale to match your URDF convention.
        multiplier= 1  → Right jaw moves in the same angular direction as Left jaw
        multiplier=-1  → Right jaw moves in the opposite angular direction (typical
                         for symmetric parallel grippers where both jaws open outward)
      Check arctos_description/urdf/arctos.xacro <mimic multiplier="…"> attribute
      for the correct value; the default here is -1 for a symmetric parallel gripper.
    -->
    <joint name="Right_jaw_joint">
      <param name="mimic">Left_jaw_joint</param>
      <param name="multiplier">-1</param>
      <command_interface name="position">
        <param name="min">-0.015</param>
        <param name="max">0.0</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

  <!-- ================================================================== -->
  <!-- Disable self-collision for the whole robot model                    -->
  <!--                                                                     -->
  <!-- Without this, arm links that contact each other during the          -->
  <!-- uncontrolled startup window (before controllers grab the joints)    -->
  <!-- trigger DART impulse responses that can be arbitrarily large when   -->
  <!-- there is penetration depth.  The result is links flying apart       -->
  <!-- ("fallen apart" appearance) that the controller then holds in place.-->
  <!--                                                                     -->
  <!-- Self-collision detection is generally not needed for a serial arm   -->
  <!-- — MoveIt handles collision avoidance at the planning level.         -->
  <!-- ================================================================== -->
  <gazebo>
    <self_collide>false</self_collide>
  </gazebo>

  <!-- ================================================================== -->
  <!-- gz_ros2_control system plugin                                        -->
  <!-- NOTE: requires gz_ros2_control built against gz-plugin 2.x          -->
  <!-- (gz-sim 8 / Harmonic). The apt package ros-humble-gz-ros2-control   -->
  <!-- 0.7.17 is compiled against gz-plugin 1.x and will NOT load.         -->
  <!-- Build from source: see README for instructions.                      -->
  <!-- ================================================================== -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find arctos_gazebo)/config/sim_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- ================================================================== -->
  <!-- Intel RealSense D435 — base-fixed, looking at the arm workspace    -->
  <!--                                                                     -->
  <!-- Parent link: base_link (fixed relative to the world — the arm's    -->
  <!-- base does not move, so this camera has a stable viewpoint of the   -->
  <!-- entire workspace regardless of arm pose).                           -->
  <!--                                                                     -->
  <!-- Mount position (adjust to suit your physical setup):               -->
  <!--   xyz="0.0 0.20 0.45"   — 20 cm in front, 45 cm above base origin  -->
  <!--                            camera faces forward toward the table    -->
  <!--   rpy="0 -0.55 1.5708"  — pitched ~31° down, yaw 90° to face +Y  -->
  <!--                            (robot forward); centres FOV on table   -->
  <!--                            at y≈0.4, z≈0.08 m                     -->
  <!--                                                                     -->
  <!-- D435 depth sensor parameters (848×480 mode):                       -->
  <!--   Horizontal FOV : 86°  (1.5009 rad)                               -->
  <!--   Vertical FOV   : 57°  (0.9948 rad, implied by 848×480 aspect)   -->
  <!--   Min depth      : 0.105 m                                          -->
  <!--   Max depth      : 10.0 m                                           -->
  <!--   Frame rate     : 30 Hz                                            -->
  <!--   Depth noise    : Gaussian σ = 0.003 m (≈ D435 at ~1 m)          -->
  <!--                                                                     -->
  <!-- Topics (via ros_gz_bridge):                                         -->
  <!--   /camera/image        — 848×480 RGB                               -->
  <!--   /camera/depth_image  — 848×480 float32 depth (metres)            -->
  <!--   /camera/camera_info  — intrinsics                                 -->
  <!--   /camera/points       — XYZRGB PointCloud2                        -->
  <!-- ================================================================== -->

  <!-- Camera body: D435 is 90×25×25 mm; approximate as a flat box -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
      <material name="realsense_body">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.072"/>  <!-- D435 mass: 72 g -->
      <inertia ixx="0.000038" iyy="0.000005" izz="0.000038"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- Mounted behind and above the base, pitched downward to cover workspace.
         Tune xyz/rpy here if you physically relocate the camera. -->
    <origin xyz="0.0 0.20 0.45" rpy="0 -0.55 1.5708"/>
  </joint>

  <!-- ROS optical frame convention: Z forward, X right, Y down.
       The -90° rotation around Z then -90° around X transforms from
       the URDF body frame (X forward) to the ROS optical convention. -->
  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- Intel RealSense D435 RGBD sensor (Gazebo Harmonic).
       Parameters match the D435 848×480 depth streaming mode.
       The rgbd_camera sensor publishes colour image, depth image,
       camera_info and a dense PointCloud2 under the <topic> prefix. -->
  <gazebo reference="camera_optical_frame">
    <sensor name="d435" type="rgbd_camera">
      <camera>
        <!-- D435 depth sensor horizontal FOV at 848×480: 86° -->
        <horizontal_fov>1.5009</horizontal_fov>
        <image>
          <!-- 848×480 — standard D435 streaming resolution -->
          <width>848</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <!-- D435 minimum reliable depth: 0.105 m -->
          <near>0.105</near>
          <!-- Practical indoor range; D435 spec is up to ~10 m -->
          <far>10.0</far>
        </clip>
        <noise>
          <!-- Depth noise: D435 accuracy is ~2 % at 1 m → ~0.02 m.
               σ = 0.003 m gives a realistic baseline for close-range work. -->
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.003</stddev>
        </noise>
      </camera>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
    </sensor>
  </gazebo>

</robot>
