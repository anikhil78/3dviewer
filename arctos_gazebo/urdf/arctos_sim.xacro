<?xml version="1.0"?>
<!--
  arctos_sim.xacro
  Robot description for Gazebo Harmonic simulation.

  Includes the mechanical model from arctos_description and adds:
    1. ros2_control block using gz_ros2_control/GazeboSimSystem (replaces the
       CAN-based ArctosInterface used on real hardware)
    2. Gazebo gz_ros2_control system plugin
    3. Intel RealSense D435 RGBD camera fixed to base_link (world-fixed
       viewpoint covering the full arm workspace)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arctos_sim">

  <!-- ================================================================== -->
  <!-- Include mechanical description (links, joints, meshes, inertias)    -->
  <!-- Do NOT include arctos.ros2_control.xacro — that uses ArctosInterface -->
  <!-- ================================================================== -->
  <xacro:include filename="$(find arctos_description)/urdf/arctos.xacro"/>

  <!-- ================================================================== -->
  <!-- Disable gravity on the robot so it holds its pose without a        -->
  <!-- controller. Joint states come from joint_state_publisher in ROS.   -->
  <!-- ================================================================== -->
  <gazebo>
    <gravity>false</gravity>
  </gazebo>

  <!-- ================================================================== -->
  <!-- Intel RealSense D435 — base-fixed, looking at the arm workspace    -->
  <!--                                                                     -->
  <!-- Parent link: base_link (fixed relative to the world — the arm's    -->
  <!-- base does not move, so this camera has a stable viewpoint of the   -->
  <!-- entire workspace regardless of arm pose).                           -->
  <!--                                                                     -->
  <!-- Mount position (adjust to suit your physical setup):               -->
  <!--   xyz="-0.08 0.0 0.18"  — 8 cm behind, 18 cm above base origin    -->
  <!--   rpy="0 0.35 0"        — pitched ~20° forward to centre the FOV  -->
  <!--                            on the arm's reachable workspace         -->
  <!--                                                                     -->
  <!-- D435 depth sensor parameters (848×480 mode):                       -->
  <!--   Horizontal FOV : 86°  (1.5009 rad)                               -->
  <!--   Vertical FOV   : 57°  (0.9948 rad, implied by 848×480 aspect)   -->
  <!--   Min depth      : 0.105 m                                          -->
  <!--   Max depth      : 10.0 m                                           -->
  <!--   Frame rate     : 30 Hz                                            -->
  <!--   Depth noise    : Gaussian σ = 0.003 m (≈ D435 at ~1 m)          -->
  <!--                                                                     -->
  <!-- Topics (via ros_gz_bridge):                                         -->
  <!--   /camera/image        — 848×480 RGB                               -->
  <!--   /camera/depth_image  — 848×480 float32 depth (metres)            -->
  <!--   /camera/camera_info  — intrinsics                                 -->
  <!--   /camera/points       — XYZRGB PointCloud2                        -->
  <!-- ================================================================== -->

  <!-- Camera body: D435 is 90×25×25 mm; approximate as a flat box -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
      <material name="realsense_body">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.072"/>  <!-- D435 mass: 72 g -->
      <inertia ixx="0.000038" iyy="0.000005" izz="0.000038"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- Mounted behind and above the base, pitched forward to cover workspace.
         Tune xyz/rpy here if you physically relocate the camera. -->
    <origin xyz="-0.08 0.0 0.18" rpy="0 0.35 0"/>
  </joint>

  <!-- ROS optical frame convention: Z forward, X right, Y down.
       The -90° rotation around Z then -90° around X transforms from
       the URDF body frame (X forward) to the ROS optical convention. -->
  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- Intel RealSense D435 RGBD sensor (Gazebo Harmonic).
       Parameters match the D435 848×480 depth streaming mode.
       The rgbd_camera sensor publishes colour image, depth image,
       camera_info and a dense PointCloud2 under the <topic> prefix. -->
  <gazebo reference="camera_optical_frame">
    <sensor name="d435" type="rgbd_camera">
      <camera>
        <!-- D435 depth sensor horizontal FOV at 848×480: 86° -->
        <horizontal_fov>1.5009</horizontal_fov>
        <image>
          <!-- 848×480 — standard D435 streaming resolution -->
          <width>848</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <!-- D435 minimum reliable depth: 0.105 m -->
          <near>0.105</near>
          <!-- Practical indoor range; D435 spec is up to ~10 m -->
          <far>10.0</far>
        </clip>
        <noise>
          <!-- Depth noise: D435 accuracy is ~2 % at 1 m → ~0.02 m.
               σ = 0.003 m gives a realistic baseline for close-range work. -->
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.003</stddev>
        </noise>
      </camera>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
    </sensor>
  </gazebo>

</robot>
