<?xml version="1.0"?>
<!--
  vision_camera.urdf.xacro
  Standalone Intel RealSense D435 camera for the vision-only simulation.

  No arm, no controllers — just a static camera fixed to the world looking
  at a tabletop workspace.

  Camera mount:
    xyz = "0.4 0.0 0.42"   — 40 cm in front of table centre, 42 cm up
    rpy = "0 0.7 3.14159"  — pitched ~40° downward, facing -X (toward table)

  Adjust the camera_joint origin to reposition the camera view.

  Topics bridged by ros_gz_bridge (via vision_sim.launch.py):
    /vision/image          — 640×480 RGB
    /vision/depth_image    — 640×480 float32 depth (metres)
    /vision/camera_info    — intrinsics (fx, fy, cx, cy)
    /vision/points         — PointCloud2 (XYZ, from Gazebo)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="vision_camera">

  <!-- World anchor — fixed to the SDF world frame by Gazebo -->
  <link name="world"/>

  <!-- Camera body: approximate D435 dimensions (90×25×25 mm) -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
      <material name="realsense_body">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.072"/>
      <inertia ixx="0.000038" iyy="0.000005" izz="0.000038"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!--
    Mount: 40 cm in front of and 42 cm above table centre.
    pitch=0.7 rad (~40°) tilts the camera downward.
    yaw=π faces the -X direction (toward the table from the +X side).
    Adjust xyz/rpy here to reframe the workspace view.
  -->
  <joint name="camera_world_joint" type="fixed">
    <parent link="world"/>
    <child link="camera_link"/>
    <origin xyz="0.4 0.0 0.42" rpy="0 0.7 3.14159"/>
  </joint>

  <!-- ROS optical frame convention: Z forward, X right, Y down. -->
  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!--
    Intel RealSense D435 RGBD sensor — 640×480, 60° horizontal FOV.
    Narrower than the 848-wide mode so the full table fits in frame
    at this mount distance.

    Depth noise: Gaussian σ=0.002 m (~2 mm at 0.5 m range).

    All topics are published under the "vision" prefix so they don't
    collide with the arm simulation's "/camera/*" topics.
  -->
  <gazebo reference="camera_optical_frame">
    <sensor name="d435_vision" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>  <!-- 60° -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>3.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.002</stddev>
        </noise>
      </camera>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>vision</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
    </sensor>
  </gazebo>

</robot>
