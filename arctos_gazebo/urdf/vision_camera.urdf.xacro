<?xml version="1.0"?>
<!--
  vision_camera.urdf.xacro
  Standalone Intel RealSense L515 LiDAR camera for the vision-only simulation.

  The L515 uses a LiDAR Time-of-Flight sensor rather than the D435's stereo
  infrared.  Key simulation differences vs D435:
    - Cylindrical body (61 mm ⌀ × 26 mm) instead of a bar
    - 70° × 55° FOV (narrower than D435's 86° × 57°)
    - Minimum range 0.25 m  ← objects closer than this have no depth return
    - Depth noise σ = 0.003 m (~3 mm) vs D435's ~10–20 mm
    - Native depth resolution 1024 × 768; downscaled to 640 × 480 here for
      WSL2 rendering performance (FOV is preserved exactly)

  Camera mount:
    xyz = "0.4 0.0 0.42"   — 40 cm in front of table centre, 42 cm up
    rpy = "0 0.7 3.14159"  — pitched ~40° downward, facing -X (toward table)
    At this distance the table (0.6 m wide) fits comfortably in the 70° FOV.
    Nearest table point is ~0.35 m — just above the 0.25 m minimum range.

  Adjust the camera_world_joint origin to reposition the camera view.

  Topics bridged by ros_gz_bridge (via vision_sim.launch.py):
    /vision/image          — 640×480 RGB
    /vision/depth_image    — 640×480 float32 depth (metres)
    /vision/camera_info    — intrinsics (fx, fy, cx, cy)
    /vision/points         — PointCloud2 (XYZ, from Gazebo)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="vision_camera">

  <!-- World anchor — fixed to the SDF world frame by Gazebo -->
  <link name="world"/>

  <!-- Camera body: L515 form factor — 61 mm diameter × 26 mm tall cylinder -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0305" length="0.026"/>
      </geometry>
      <material name="realsense_body">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.100"/>  <!-- L515: 100 g -->
      <inertia ixx="0.000041" iyy="0.000041" izz="0.000047"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!--
    Mount: 40 cm in front of and 42 cm above table centre.
    pitch=0.7 rad (~40°) tilts the camera downward.
    yaw=π faces the -X direction (toward the table from the +X side).
    Adjust xyz/rpy here to reframe the workspace view.
  -->
  <joint name="camera_world_joint" type="fixed">
    <parent link="world"/>
    <child link="camera_link"/>
    <origin xyz="0.4 0.0 0.42" rpy="0 0.7 3.14159"/>
  </joint>

  <!-- ROS optical frame convention: Z forward, X right, Y down. -->
  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!--
    Intel RealSense L515 LiDAR sensor.

    Spec        Real L515        Simulated here
    =========   ========         ================
    H FOV       70°              70° (1.2217 rad)
    V FOV       55°              55° (aspect ratio 640×480 ≈ 4:3 ≈ 56°)
    Depth res   1024 × 768       640 × 480  (same FOV, lighter for WSL2)
    Min range   0.25 m           0.25 m  ← objects closer give no return
    Max range   9 m              9 m
    Noise       ~3–5 mm          σ = 0.003 m (Gaussian)
    Rate        30 fps           30 fps

    The ToF nature means noise is uniform across the image (no stereo
    falloff toward edges), so a single Gaussian model is appropriate.

    All topics are published under the "vision" prefix so they don't
    collide with the arm simulation's "/camera/*" topics.
  -->
  <gazebo reference="camera_optical_frame">
    <sensor name="l515_vision" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.2217</horizontal_fov>  <!-- 70° -->
        <image>
          <width>640</width>
          <height>480</height>   <!-- 4:3 → V FOV ≈ 55°; matches real L515 -->
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.25</near>   <!-- L515 minimum range: 0.25 m -->
          <far>9.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.003</stddev>  <!-- ~3 mm; ToF is far more precise than stereo -->
        </noise>
      </camera>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>vision</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
    </sensor>
  </gazebo>

</robot>
